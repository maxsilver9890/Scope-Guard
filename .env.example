# Copy to .env.local and fill in real values. Never commit .env.local.
# The dev server reads this file at startup; restart `npm run dev` after edits.

# Provider API key (OpenRouter in the current setup).
DEEPSEEK_API_KEY=

# OpenAI-compatible base URL. OpenRouter:
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1

# Fixed model. Do not use openrouter/free; it can route to different models.
DEEPSEEK_MODEL=dots-studio/dots-3-note-preview:free

# Optional per-request timeout in milliseconds (default 75000).
# DEEPSEEK_TIMEOUT_MS=75000