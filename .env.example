# Copy to .env.local and fill in real values. Never commit .env.local.
# The dev server reads this file at startup; restart `npm run dev` after edits.

# Provider API key (OpenRouter in the current setup).
DEEPSEEK_API_KEY=

# OpenAI-compatible base URL. OpenRouter:
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1

# Fixed fallback model. Do not use openrouter/free; it can route to different models.
DEEPSEEK_MODEL=dots-studio/dots-3-note-preview:free

# Optional analysis-model override. Takes precedence over DEEPSEEK_MODEL.
# Use an OpenRouter-compatible model id when you need a faster or more reliable model.
# SCOPE_GUARD_MODEL=

# Dedicated OpenRouter speech-to-text model; this does not replace the analysis model.
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-transcribe

# Per-model-call budget in milliseconds (default 60000).
# DEEPSEEK_TIMEOUT_MS=60000

# Retry attempts for transient provider failures (default 2, maximum 3).
# DEEPSEEK_MAX_ATTEMPTS=2

# Overall analysis-pipeline budget in milliseconds (default 75000).
# Budget includes generation, review, and the conditional reconciliation pass.
# SCOPE_GUARD_PIPELINE_TIMEOUT_MS=75000
